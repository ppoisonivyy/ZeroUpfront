# Server-side only. Use an API project key from the organization with your credits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_OCR_MODEL=gpt-6.2-astra
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional reuse of an existing prepared store in the same OpenAI project.
OPENAI_VECTOR_STORE_ID=

# The local coordinator workspace starts a private PostgreSQL cluster by default.
# For a dedicated external demo database, supply its PostgreSQL connection string.
# For networked staff deployments use a certificate hostname, sslmode=verify-full,
# and the provider's CA (PGSSLROOTCERT). The release image defaults to verify-full.
DATABASE_URL=
# Set to 1 to allow opt-in server-side OpenAI OCR for supported document uploads.
WORKSPACE_ENABLE_OCR=0
# Opt in to staff-requested original guarantee fee-clause reads and full discharge packet second reads.
WORKSPACE_ENABLE_AI_REVIEW=0
# Allow staff in a local Pattaya practice case to request read-only OpenAI tool calls.
WORKSPACE_ENABLE_PATTAYA_AI=0

# Networked service defaults to staff access with an empty database.
# The local launcher selects local rehearsal for its private loopback database.
# Optional public display name on staff sign-in and in the workspace. Restart to apply.
WORKSPACE_HOSPITAL_NAME=
# WORKSPACE_AUTH_MODE=staff
# WORKSPACE_SEED_DEMO=0
# FORWARDED_ALLOW_IPS=ip-address-of-your-trusted-reverse-proxy

# Optional hospital directory. Each environment variable names a dedicated database secret.
# WORKSPACE_HOSPITALS={"canal-bridge":{"hospital_name":"Canal Bridge Demo Hospital","database_url_env":"CANAL_DATABASE_URL"},"lakeside":{"hospital_name":"Lakeside Demo Hospital","database_url_env":"LAKESIDE_DATABASE_URL"}}
# CANAL_DATABASE_URL=
# LAKESIDE_DATABASE_URL=
